{
    "name": "jarrivero/trivial",
    "description": "Multiplayer trivia game to play with friends (Slim 4 + Eloquent + SQLite + Smarty)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo_sqlite": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "illuminate/database": "^11.0",
        "smarty/smarty": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
